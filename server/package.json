{
  "name": "afro-suite-server",
  "version": "1.0.0",
  "private": true,
  "description": "AFRO Suite multi-tenant platform API (pharmacy, store, hospital, school)",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
