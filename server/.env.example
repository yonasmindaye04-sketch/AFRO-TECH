# ── Database ──────────────────────────────────────────────
# Local (discrete vars):
DB_HOST=localhost
DB_PORT=5432
DB_NAME=afro_suite
DB_USER=postgres
DB_PASSWORD=your_password
# Cloud (Neon/Supabase/Render): single connection string overrides the vars above.
# DATABASE_URL=postgres://user:pass@host/dbname?sslmode=require
# PGSSL=false  # force no TLS on trusted private networks

# ── Server ────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# Public URL of the site (used for CORS). Comma-separate extra origins if needed.
PUBLIC_URL=http://localhost:5173

# ── Auth ──────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_generate_a_long_random_hex
JWT_EXPIRES_IN=7d

# ── Google sign-in (optional — enables GET /auth/google) ─────
# Create OAuth credentials at https://console.cloud.google.com (OAuth client ID, Web app)
# and add this redirect URI: <PUBLIC_URL>/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Trial length in days for newly registered tenants
TRIAL_DAYS=45

# ── AFRO-TECH platform admin seed (npm run seed) ─────────
ADMIN_EMAIL=admin@afrotech.et
ADMIN_PASSWORD=ChangeMeNow!
ADMIN_NAME=AFRO-TECH Admin

# ── Contact form (optional, enables POST /api/contact) ───
CONTACT_EMAIL=yonasmindaye04@gmail.com
CONTACT_USER=
CONTACT_PASS=

# ── Telegram bot + Mini App (optional) ────────────────────
# Create a bot with @BotFather, paste its token here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Production: set your public URL + webhook secret, then run the setWebhook
# command from DEPLOY.md. Leave TELEGRAM_WEBHOOK_URL empty for dev (long-polling).
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
# # Overrides the Mini App URL if it differs from PUBLIC_URL/app
TELEGRAM_WEBAPP_URL=

# ── Hosting / delivery mode ──────────────────────────────
# Public origin of THIS api (used for tenant-bot webhooks + Chapa callbacks).
# On Render this is provided automatically as RENDER_EXTERNAL_URL.
RENDER_EXTERNAL_URL=
# If unset, tenant bots use long-polling (dev). If set, tenant bots use webhooks.

# ── Payments / Subscription billing (optional in dev) ────────
# Chapa is the primary provider (https://chapa.co).
# If CHAPA_SECRET_KEY is blank AND NODE_ENV != production, the server falls
# back to a mock provider for local development. In production a real key is
# required or /billing endpoints return 503.
CHAPA_SECRET_KEY=
# Set in your Chapa dashboard (Settings → Webhook secret hash).
# When set, incoming /api/v1/billing/webhook/chapa requests must carry a valid
# HMAC-SHA256 signature on the x-chapa-signature header.
CHAPA_WEBHOOK_SECRET=
# Public URL of the API (used for the Chapa callback URL). Defaults to PUBLIC_URL.
BACKEND_PUBLIC_URL=

# ── Marketing / Campaigns ──────────────────────────────────
# Upstash Redis (for BullMQ queue) — get from https://console.upstash.com
UPSTASH_REDIS_URL=rediss://default:xxx@xxx.upstash.io:6379

# Resend (email) — get from https://resend.com/api-keys
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=noreply@yourdomain.com

# EthioTelecom SMPP (SMS) — use ETHIOTELECOM_MOCK=true for dev without real SMPP
ETHIOTELECOM_SMPP_HOST=smpp.ethiotelecom.et
ETHIOTELECOM_SMPP_PORT=2775
ETHIOTELECOM_SMPP_USERNAME=your_system_id
ETHIOTELECOM_SMPP_PASSWORD=your_password
ETHIOTELECOM_SENDER_ID=AFROTECH
ETHIOTELECOM_MOCK=true

# ─── Payment providers (ported from yekis) ───────────────────
# Telebirr C2B Web Checkout (Ethio telecom). Get credentials from the
# Telebirr merchant portal. Leave unset to hide Telebirr at checkout.
# TELEBIRR_BASE_URL=https://developerportal.ethiotelebirr.et:38443/apiaccess/payment/gateway
# TELEBIRR_WEB_BASE_URL=https://developerportal.ethiotelebirr.et:38443/payment/web/paygate?
# TELEBIRR_FABRIC_APP_ID=                # X-APP-Key header for token/preOrder
# TELEBIRR_APP_SECRET=                   # secret used to obtain the fabric token
# TELEBIRR_MERCHANT_APP_ID=              # appid inside order payloads
# TELEBIRR_MERCHANT_CODE=                # 6-digit merchant shortcode / till number
# TELEBIRR_PRIVATE_KEY=                  # RSA PKCS#8 PEM private key (signing requests)
# TELEBIRR_PUBLIC_KEY=                   # Telebirr RSA public key (verifying webhooks)
# TELEBIRR_NOTIFY_URL=                   # defaults to <BACKEND_PUBLIC_URL>/api/v1/billing/webhook/telebirr
# TELEBIRR_TIMEOUT_EXPRESS=120m          # checkout link expiry

# M-Pesa (Safaricom Ethiopia) C2B - https://developer.safaricom.et
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_BUSINESS_SHORT_CODE=
# MPESA_API_URL=https://apisandbox.safaricom.et
# MPESA_CHECKOUT_URL=                    # hosted checkout page, if provisioned
# MPESA_CALLBACK_SECRET=                 # HMAC secret verifying x-mpesa-signature

# CBE Birr (Commercial Bank of Ethiopia) - manual-transfer flow;
# the webhook secret lets the bank confirm payments server-to-server.
# CBE_WEBHOOK_SECRET=

# Payment reconciliation sweep (missed-webhook safety net)
# PAYMENT_RECONCILE_INTERVAL_MS=300000
# PAYMENT_RECONCILE_STALE_MINUTES=10
# PAYMENT_RECONCILE_GIVE_UP_HOURS=26
